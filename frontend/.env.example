# Copy to .env.local for local overrides, or set these in the Vercel dashboard
# (Project → Settings → Environment Variables).

# Base URL of the deployed backend (no trailing slash). When empty, the Vite
# dev server proxies /predict, /health and /files to http://localhost:8000.
# In production (Vercel) this MUST point at your Render service, e.g.:
# VITE_API_BASE_URL=https://signalscope-api.onrender.com
VITE_API_BASE_URL=
